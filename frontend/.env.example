# Production / Vercel frontend environment variable:
VITE_API_URL=https://heavevgymbackendapplication.vercel.app/api

# Optional local-backend override for Vite development.
# Copy this file to .env.development.local and uncomment the line below
# when the backend is running locally on port 5000.
# VITE_PROXY_TARGET=http://localhost:5000

# By default, local Vite development proxies /api to the deployed backend.
