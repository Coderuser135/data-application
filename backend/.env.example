# Server
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/gym_management?retryWrites=true&w=majority

# Auth - use long random values (32+ bytes) and keep them different
JWT_ACCESS_SECRET=replace_with_32_plus_byte_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_plus_byte_random_secret

# Frontend origins - comma separated when more than one
CLIENT_URL=https://your-gym-frontend.netlify.app

# Cross-site cookie settings for Netlify frontend + Vercel backend
COOKIE_SAME_SITE=none

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Scheduled jobs
CRON_SECRET=replace_with_a_long_random_cron_secret
DISABLE_IN_PROCESS_JOBS=true

# Gym/business settings
GYM_TIMEZONE=Asia/Kolkata
MEMBERSHIP_ADVANCE_AMOUNT=1000

# Password reset email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="IronForge Gym <no-reply@example.com>"
