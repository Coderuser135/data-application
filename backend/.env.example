# Server
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/gym_management?retryWrites=true&w=majority

# Auth - use long random values (32+ bytes) and keep them different
OTP_SECRET=replace_with_a_separate_32_plus_byte_random_secret
JWT_ACCESS_SECRET=replace_with_32_plus_byte_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_plus_byte_random_secret

# Exact frontend origin. Add other trusted origins comma-separated if required.
CLIENT_URL=https://heavengymfrontend-application.vercel.app

# Required for secure cookies between the separate Vercel frontend and backend domains.
COOKIE_SAME_SITE=none

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Scheduled jobs
CRON_SECRET=replace_with_a_long_random_cron_secret
DISABLE_IN_PROCESS_JOBS=true

# Gym/business settings
GYM_TIMEZONE=Asia/Kolkata
MEMBERSHIP_ADVANCE_AMOUNT=1000

# Gmail SMTP (use a Google App Password, NOT your normal Google password)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password

# Optional fallback: another SMTP provider
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM="Heaven Gym <no-reply@example.com>"
